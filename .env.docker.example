POSTGRES_PASSWORD=replace_with_a_private_password
DATABASE_URL=postgresql://postgres:replace_with_a_private_password@db:5432/project_db
# Public hostname the proxy serves. Leave as `localhost` for local use (Caddy uses
# its own internal CA). Set it to your domain on a real server to get automatic
# Let's Encrypt certificates.
SITE_ADDRESS=localhost
# Shared secret the in-game plugin uses to call /internal/link/claim. Leave it unset
# to disable that endpoint (it then answers 503). scripts/mc-init.sh generates it for
# you; to set one by hand: openssl rand -hex 32
# LINK_SERVICE_TOKEN=

# --- Minecraft server -------------------------------------------------------
# Shared secret for Velocity <-> backend modern player-info forwarding.
# scripts/mc-init.sh generates this for you if it is empty.
VELOCITY_SECRET=
# Backend Minecraft version. LATEST follows releases; pin an exact version (e.g.
# 1.21.8) once you know what you are running, so redeploys do not change it.
MC_VERSION=LATEST
# Heap size for the backend server.
MC_MEMORY=4G
