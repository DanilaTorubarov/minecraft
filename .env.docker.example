POSTGRES_PASSWORD=replace_with_a_private_password
DATABASE_URL=postgresql://postgres:replace_with_a_private_password@db:5432/project_db
# Public hostname the proxy serves. Leave as `localhost` for local use (Caddy uses
# its own internal CA). Set it to your domain on a real server to get automatic
# Let's Encrypt certificates.
SITE_ADDRESS=localhost
# Email: local preview inbox at http://localhost:8025 (start the mailpit service).
# For real delivery use your provider's SMTP host, STARTTLS/587 or TLS/465,
# credentials, a verified sender domain, and the public HTTPS website origin.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_TLS=none
SMTP_FROM=accounts@example.test
PUBLIC_SITE_URL=https://localhost
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Shared secret the in-game plugin uses to call /internal/link/claim. Leave it unset
# to disable that endpoint (it then answers 503). scripts/mc-init.sh generates it for
# you; to set one by hand: openssl rand -hex 32
# LINK_SERVICE_TOKEN=

# --- Minecraft server -------------------------------------------------------
# Shared secret for Velocity <-> backend modern player-info forwarding.
# scripts/mc-init.sh generates this for you if it is empty.
VELOCITY_SECRET=
# Backend Minecraft version. LATEST follows releases; pin an exact version (e.g.
# 1.21.8) once you know what you are running, so redeploys do not change it.
MC_VERSION=LATEST
# Optional: use a verified, read-only Purpur 26.3 build 2652 jar instead of the
# startup downloader. Run scripts/install-local-purpur.sh first; see README.
# COMPOSE_FILE=compose.yaml:compose.purpur-local.yaml
# Heap size for the backend server.
MC_MEMORY=4G

# Optional higher limits for website skin signing. Never sent to browsers.
# Anonymous MineSkin requests work with lower service limits.
# MINESKIN_API_KEY=

# Economy: UTC qualifying gameplay and daily gradual policy reviews.
ECONOMY_ACTIVE_SECONDS=7200
ECONOMY_ACTIVE_DAYS=3
ECONOMY_ACTIVE_DAY_SECONDS=300
ECONOMY_AUTOMATION=true
