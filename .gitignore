# Rust build output
/target/

# Frontend dependencies and build output
/frontend/node_modules/
/frontend/dist/
/frontend/dist-ssr/

# Local configuration and secrets
.env*
!.env.example
!.env.docker.example

# Machine-local Compose overrides (e.g. the community Postgres image a host
# whose pgdata cluster is not the hardened image's needs — see AGENTS.md
# "Traps"). Never deploy these; main keeps the hardened images.
compose.override.yaml

# Logs and machine-specific files
*.log
.DS_Store
.idea/
.vscode/

# Minecraft server runtime data: worlds, downloaded jars, plugins and the
# forwarding secret. Config templates live in mc-config/ and ARE committed.
/mc/

# LinkBridge plugin build output. The plugin source in /plugin/ IS committed;
# only the Gradle output and the downloaded compile-time jars are not.
/.plugin-build/
/plugin/build/
/plugin/.gradle/

# Export bundles
/project-export-*.tar.gz

# Local visual verification captures (the design brief remains tracked).
/.impeccable/review/


# Reproducible simulation output is uploaded by CI, not committed.
/reports/economy/

# Cloud sync cache and Python bytecache
/.tmp.drive*/
__pycache__/
*.pyc
